/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Obrázky se drží den — po výměně snímků proto zvednout ?v= v index.html,
# jinak návštěvník (i Cloudflare) dál vidí staré.
/img/*
  Cache-Control: public, max-age=86400

# Styly a stránky se vždy ověří u serveru (levný dotaz s ETag). Výchozí
# čtyřhodinová cache Cloudflaru nechala po úpravě webu starý vzhled —
# nové prvky pak byly vidět jako holý text.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Kategorie coinů čte aplikace z GitHub Pages / APK — jiný původ, proto CORS.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
