# Do repozitáře nikdy nesmí API klíče ani secret.
# Klíče žijí výhradně v localStorage telefonu — tady nemají co dělat.
.env
.env.*
*.key
*.secret
secrets.json
keys.json

# Nástroje
node_modules/
_site/
.DS_Store
Thumbs.db
*.log

# testy z tools/
__pycache__/
*.pyc
# snimky obrazovky z testu (ukladaji se do temp, tohle je pojistka)
/*.png

# Obal pro Android: projekt android/ se generuje v GitHub Actions
# (`cap add android`), do repa se nedává. Podpisový klíč už vůbec ne.
apk/android/
apk/package-lock.json
*.keystore
*.jks
*.p12
